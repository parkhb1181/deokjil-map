# 카카오 REST API 키, 지오코딩 배치용 (scripts/geocode.mjs). 브라우저에 노출되지 않는다
KAKAO_REST_KEY=

# 카카오 JavaScript 키, 지도 렌더링용. 배포 URL 확정 후 콘솔에 도메인 등록 필요
# 비어 있으면 지도 탭이 리스트로 폴백된다
NEXT_PUBLIC_KAKAO_JS_KEY=

# GA4 측정 ID (G-XXXXXXXXXX). 비어 있으면 계측이 콘솔 로그로만 동작
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity 프로젝트 ID. 세션 리코딩·히트맵. 비어 있으면 미삽입
NEXT_PUBLIC_CLARITY_ID=

# Vercel Analytics 는 키가 없다. Vercel 배포 환경에서 자동으로 전송된다

# 와이어프레임 화면(/p · /me · /login · /admin15616 ...)을 연다.
# 비워두면 실서비스 배포다. 그 화면들은 404 가 되고 콘서트 목데이터도
# 번들에서 빠진다. npm run dev 는 이 값과 무관하게 늘 열린다.
# 팀에 보여줄 미리보기 배포에만 1 을 준다.
NEXT_PUBLIC_WIREFRAME=

# 백엔드 API 주소. 비어 있으면 번들에 든 목데이터로 돈다(지금 상태).
# 백엔드에 /api/v1/events 가 생기고 도메인·인증서가 붙으면 이 값을 채운다.
# 그것 하나로 실서비스 데이터로 갈아탄다.
#
# http:// 는 안 된다. duckmoim.com 이 HTTPS 라 브라우저가 막는다
# (mixed content). 지금 EC2 는 http://3.34.148.51:8080 이라 그대로는 못 쓴다.
NEXT_PUBLIC_API_BASE=

# ISR 재검증 주기(초). 안 주면 3600. 회의에서 정해지면 이 값만 바꾼다
NEXT_PUBLIC_REVALIDATE=
